# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SERVER-ONLY SECRET VARIABLES (Never exposed to client / browser bundle)
# ==============================================================================
# Storage Provider: "bunny-stream"
VIDEO_STORAGE_PROVIDER="bunny-stream"

# ------------------------------------------------------------------------------
# BUNNY STREAM VIDEO PLATFORM CONFIGURATION
# ------------------------------------------------------------------------------
# Bunny Stream Video Library ID (Found under Stream -> Video Library -> API)
BUNNY_STREAM_LIBRARY_ID="your_video_library_id"

# Bunny Stream API Key (Found under Stream -> Video Library -> API)
BUNNY_STREAM_API_KEY="your_bunny_stream_api_key"

# Bunny Stream CDN Hostname / Pull Zone (Optional, e.g. vz-xxxx.b-cdn.net or custom domain)
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxx.b-cdn.net"

# ==============================================================================
# CLIENT-SAFE VARIABLES (Frontend Firebase Configuration)
